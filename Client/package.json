{
  "name": "psa-hired-app",
  "version": "0.2.6",
  "description": "PSA Hired Tracking System",
  "author": "TechCraft by Chano",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "server": "npm run dev --prefix server",
    "client": "npm start --prefix psahiretrack",
    "electron": "wait-on http://localhost:3000 && electron .",
    "frontend": "concurrently \"npm run client\" \"npm run electron\"",
    "dev": "concurrently \"npm run server\" \"npm run client\" \"npm run electron\"",
    "build-react": "npm run build --prefix psahiretrack",
    "build-electron": "electron-builder",
    "build": "npm run build-react && npm run build-electron",
    "publish": "npm run build-react && electron-builder --publish always"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "nodemon": "^3.0.2",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.7.3",
    "node-fetch": "^3.3.2",
    "papaparse": "^5.5.3",
    "uuid": "^13.0.0"
  },
  "build": {
    "appId": "com.psa.hired",
    "productName": "PSA Kalinga HireTrack",
    "files": [
      "psahiretrack/build/**/*",
      "main.js",
      "preload.js",
      "node_modules/**/*",
      "client_secret.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "System.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Syano18",
      "repo": "PSA-HireTrack"
    },
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    }
  }
}